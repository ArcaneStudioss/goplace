# Copie para .env.local (desenvolvimento) ou .env.production.local (empacotar para a Discloud).
# Sem DATABASE_URL o site usa um banco local (PGlite em .dados/), so para desenvolvimento.
DATABASE_URL=
# Endereco publico do site, sem barra no fim
SITE_URL=https://exemplo.invalid
# Segredo longo e aleatorio (openssl rand -base64 48). Assina sessoes e hashes de IP.
SESSION_SECRET=
# Primeiro acesso ao painel: cria este usuario se ainda nao existir nenhum (troque a senha depois)
ADMIN_EMAIL=
ADMIN_SENHA=
# Fotos e video: em producao ficam no Supabase Storage (o disco da hospedagem pode ser apagado)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=loja-modelo
# Backup diario do banco (playbooks/backup.md): Cloudflare R2 ou Backblaze B2, FORA da hospedagem.
# A chave de criptografia tambem fica guardada fora do servidor (gerenciador de senhas do Gabriel).
BACKUP_CHAVE=
BACKUP_S3_ENDPOINT=https://CONTA.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=
BACKUP_S3_REGIAO=auto
BACKUP_S3_CHAVE_ID=
BACKUP_S3_SEGREDO=
