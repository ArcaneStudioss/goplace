{
  "name": "loja-modelo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "node --max-old-space-size=700 node_modules/next/dist/bin/next start -p 8080 -H 0.0.0.0",
    "lint": "eslint",
    "test": "vitest run",
    "db:migrar": "tsx --conditions=react-server scripts/banco.ts migrar",
