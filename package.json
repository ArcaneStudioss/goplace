    "backup": "tsx --conditions=react-server scripts/banco.ts backup",
    "restaurar": "tsx --conditions=react-server scripts/banco.ts restaurar"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "clsx": "^2.1.1",
    "geist": "^1.4.2",
